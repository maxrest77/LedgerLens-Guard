# Backend secrets — copy to .env, never commit .env
SECRET_KEY=change_this_to_a_long_random_string_in_production
DATABASE_URL=sqlite:///./ledgerlens.db
ALLOWED_ORIGINS=http://localhost:5173
TOKEN_EXPIRE_HOURS=8

# Demo reviewer seeds (used by seed.py)
REVIEWER_1_EMAIL=reviewer@ledgerlens.dev
REVIEWER_1_PASSWORD=demo_reviewer_2024
REVIEWER_2_EMAIL=admin@ledgerlens.dev
REVIEWER_2_PASSWORD=demo_admin_2024

# Razorpay webhook secret (for HMAC verification)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
