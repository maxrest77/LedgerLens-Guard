# ==============================================================================
# LedgerLens Guard — Environment Configuration Template
# ==============================================================================

# Application Environment: development | staging | production
ENV=development

# RBI Payment Data Localization (mandated India regions: ap-south-1, ap-south-2, asia-south1, asia-south2, centralindia)
HOSTING_REGION=ap-south-1

# Primary Database Connection URL
# For SQLite (default demo): sqlite:///backend/ledgerlens.db
# For PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/ledgerlens
DATABASE_URL=sqlite:///backend/ledgerlens.db

# JWT & Cryptographic Secret Key
# WARNING: In production (ENV=production), startup will abort if left at default or <32 characters.
# Generate a strong key with: openssl rand -hex 32
SECRET_KEY=change_this_to_a_long_random_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Gateway Webhook HMAC Signatures
VELOCEPAY_WEBHOOK_SECRET=your_velocepay_webhook_secret_here
PRISMPAY_WEBHOOK_SECRET=your_prismpay_webhook_secret_here

# Column-Level PII Encryption Key (Fernet 32-byte url-safe base64)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Security Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Observability & Logging: text | json
LOG_FORMAT=text

# Sovereign AI Finance Controller (Optional external model integration)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Seed Account Credentials (Optional overrides for db/seed.py)
REVIEWER_1_EMAIL=reviewer@ledgerlens.dev
REVIEWER_1_PASSWORD=
REVIEWER_2_EMAIL=admin@ledgerlens.dev
REVIEWER_2_PASSWORD=
